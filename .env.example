# Isaac AI Agent Configuration

# ===========================
# DeepSeek (Anthropic-compatible) API Configuration
# ===========================
ANTHROPIC_API_KEY=sk-your-deepseek-api-key-here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# 可选: 指定模型（默认 deepseek-v4-pro）
DEEPSEEK_ANTHROPIC_MODEL=deepseek-v4-pro

# 兼容旧变量（可不填）
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ===========================
# Document Processing
# ===========================
# Directory containing Isaac API markdown files
DOCS_DIR=./docs
# Directory for processed output
OUTPUT_DIR=./processed_docs

# ===========================
# API Server Configuration
# ===========================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ===========================
# Logging Configuration
# ===========================
LOG_LEVEL=INFO
LOG_FILE=logs/isaac-agent.log

# ===========================
# Data & RAG Configuration (Future Use)
# ===========================
FAISS_INDEX_PATH=./data/isaac_api.index
VECTOR_DB_TYPE=faiss

# ===========================
# Isaac Mod Settings
# ===========================
ISAAC_MOD_DIR=./mods
ISAAC_VERSION=1.7
LUA_VALIDATOR=luacheck

# ===========================
# Development Settings
# ===========================
DEV_MODE=True
MOCK_API=True


FROM python:3.12-slim-bookworm
WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl git build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency resolution
RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock* ./

# Install full project with all extras
RUN uv sync --extra gui --no-dev 2>/dev/null || \
    pip install --no-cache-dir \
      fastapi uvicorn nicegui \
      langchain langchain-core langchain-openai langchain-community \
      langgraph pydantic pydantic-settings \
      loguru faiss-cpu sentence-transformers \
      anthropic

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 8080 8000
